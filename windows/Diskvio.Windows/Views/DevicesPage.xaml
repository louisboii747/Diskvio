<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Diskvio.Windows.Views.DevicesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="using:Diskvio.Windows.Converters" xmlns:controls="using:Diskvio.Windows.Controls" Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Page.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Visible" />
  </Page.Resources>
  <Grid Padding="24" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
      <CommandBar.Content>
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="Devices" Style="{ThemeResource TitleTextBlockStyle}" />
          <TextBlock Text="{Binding DeviceCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </CommandBar.Content>
      <AppBarButton Label="Refresh" Icon="Refresh" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Refresh devices (Ctrl+R)">
        <AppBarButton.KeyboardAccelerators>
          <KeyboardAccelerator Key="R" Modifiers="Control" />
          <KeyboardAccelerator Key="F5" />
        </AppBarButton.KeyboardAccelerators>
      </AppBarButton>
      <AppBarSeparator />
      <AppBarButton Label="Mount" Icon="Add" IsEnabled="{Binding CanMount}" Click="OnMount" />
      <AppBarButton Label="Unmount" Icon="Remove" IsEnabled="{Binding CanUnmount}" Click="OnUnmount" />
      <AppBarButton Label="Eject (unsupported)" IsEnabled="False" ToolTipService.ToolTip="Physical eject is unsupported on Windows">
        <AppBarButton.Icon>
          <FontIcon Glyph="" />
        </AppBarButton.Icon>
      </AppBarButton>
    </CommandBar>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.Name="Working with the Rust backend" />
    <StackPanel Grid.Row="2" Spacing="8">
      <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error" Title="Device request failed" Message="{Binding ErrorMessage}" />
      <InfoBar IsOpen="{Binding HasResult}" IsClosable="False" Severity="Success" Title="Operation completed" Message="{Binding ResultMessage}" />
      <InfoBar IsOpen="{Binding HasWarnings}" IsClosable="False" Severity="Warning" Title="Partial discovery — actions unavailable" Message="{Binding Warnings}" />
    </StackPanel>
    <TextBlock Grid.Row="3" Text="No physical disks reported. Refresh to discover connected devices." TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
    <Grid x:Name="WorkspaceGrid" Grid.Row="4" ColumnSpacing="24" RowSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="NavigationRow" Height="*" />
        <RowDefinition x:Name="DetailRow" Height="0" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="NavigationScroll">
        <StackPanel Spacing="12">
          <TextBlock Text="PHYSICAL DISKS" Style="{ThemeResource CaptionTextBlockStyle}" />
          <ListView x:Name="DeviceList" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk, Mode=TwoWay}" SelectionChanged="OnDiskSelectionChanged" IsEnabled="{Binding CanInspect}" AutomationProperties.Name="Physical disks">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="4,12" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="{Binding Icon}" FontSize="20" />
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding AccessibleName}" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Text="UNATTACHED VOLUMES" Style="{ThemeResource CaptionTextBlockStyle}" />
          <ListView x:Name="UnattachedList" ItemsSource="{Binding UnattachedVolumes}" SelectionChanged="OnUnattachedSelected" IsEnabled="{Binding CanInspect}" AutomationProperties.Name="Volumes without a resolved disk">
            <ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Text="{Binding ActionExplanation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DetailScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SelectionName}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectionSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel Spacing="10">
            <Button Content="Disk details" Click="OnDiskDetails" IsEnabled="{Binding CanInspect}" />
            <TextBlock Text="Partition layout" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{Binding Layout.Explanation}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
            <controls:PartitionMap x:Name="Map" IsEnabled="{Binding CanInspect}" />
            <ItemsControl x:Name="PartitionLegend" IsEnabled="{Binding CanInspect}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding AccessibleName}" Tag="{Binding}" Click="OnPartitionLegend" Margin="0,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="10">
            <TextBlock Text="Partitions and volumes" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView x:Name="ChildList" ItemsSource="{Binding Children}" SelectionChanged="OnExplorerSelectionChanged" IsEnabled="{Binding CanInspect}" AutomationProperties.Name="Partitions and volumes">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Padding="4,10" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" />
                    <TextBlock Text="{Binding Device.Identifier}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
          <StackPanel Spacing="12">
            <TextBlock Text="Inspector" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ItemsControl ItemsSource="{Binding Properties}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,14" Spacing="4">
                    <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{Binding Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>