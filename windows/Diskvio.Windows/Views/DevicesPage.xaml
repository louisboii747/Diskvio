<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Diskvio.Windows.Views.DevicesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="using:Diskvio.Windows.Converters" xmlns:controls="using:Diskvio.Windows.Controls" Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Page.Resources><converters:BooleanToVisibilityConverter x:Key="Visible" /></Page.Resources>
  <Grid Padding="24,16,24,24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
      <CommandBar.Content>
        <StackPanel Margin="0,0,24,0">
          <TextBlock Text="Devices" Style="{ThemeResource TitleTextBlockStyle}" />
          <TextBlock Text="{Binding DeviceCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>
      </CommandBar.Content>
      <AppBarButton Label="Refresh" Icon="Refresh" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Refresh disks and volumes (Ctrl+R or F5)">
        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="R" Modifiers="Control" /><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
      </AppBarButton>
      <AppBarSeparator />
      <AppBarButton Label="Rename label" Icon="Edit" IsEnabled="{Binding CanRename}" Click="OnRename" ToolTipService.ToolTip="Rename the selected volume, subject to backend safety checks" />
      <AppBarButton Label="Drive letter" IsEnabled="{Binding CanSetDriveLetter}" Click="OnDriveLetter"><AppBarButton.Icon><FontIcon Glyph="&#xE8D4;" /></AppBarButton.Icon></AppBarButton>
      <AppBarButton Label="Mount" Icon="Add" IsEnabled="{Binding CanMount}" Click="OnMount" />
      <AppBarButton Label="Unmount" Icon="Remove" IsEnabled="{Binding CanUnmount}" Click="OnUnmount" />
    </CommandBar>
    <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.Name="Reading or updating storage" />
    <StackPanel Grid.Row="2" Spacing="8">
      <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error" Title="Storage request failed" Message="{Binding ErrorMessage}" />
      <InfoBar IsOpen="{Binding HasResult}" IsClosable="False" Severity="Success" Title="Operation completed" Message="{Binding ResultMessage}" />
      <InfoBar IsOpen="{Binding HasWarnings}" IsClosable="False" Severity="Warning" Title="Partial discovery — actions unavailable" Message="{Binding Warnings}" />
    </StackPanel>
    <TextBlock Grid.Row="3" Text="No physical disks reported. Connect a device and refresh. Any unattached volumes remain available below." TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
    <Grid x:Name="WorkspaceGrid" Grid.Row="4" ColumnSpacing="24" RowSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="NavigationRow" Height="*" /><RowDefinition x:Name="DetailRow" Height="0" /></Grid.RowDefinitions>
      <ScrollViewer x:Name="NavigationScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <TextBlock Text="Physical disks" FontWeight="SemiBold" />
          <ListView x:Name="DeviceList" ContextRequested="OnContextRequested" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk, Mode=TwoWay}" SelectionChanged="OnDiskSelectionChanged" IsEnabled="{Binding CanInspect}" AutomationProperties.Name="Physical disks">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate>
              <Grid Padding="2,10" ColumnSpacing="10" ContextRequested="OnContextRequested">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Icon}" FontSize="20" VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding AccessibleName}" />
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                  <TextBlock Text="{Binding Badges}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
              </Grid>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
          <Expander Header="Unattached volumes" HorizontalAlignment="Stretch">
            <ListView x:Name="UnattachedList" ContextRequested="OnContextRequested" ItemsSource="{Binding UnattachedVolumes}" SelectionChanged="OnUnattachedSelected" IsEnabled="{Binding CanInspect}" AutomationProperties.Name="Volumes without a resolved disk">
              <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ContextRequested="OnContextRequested" ToolTipService.ToolTip="{Binding AccessibleName}" /></DataTemplate></ListView.ItemTemplate>
            </ListView>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DetailScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ContentGrid" ColumnSpacing="24" RowSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="0" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SelectionName}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="{Binding SelectionBadges}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="10" Visibility="{Binding HasDiskSelection, Converter={StaticResource Visible}}">
              <Grid><TextBlock Text="Partition layout" FontWeight="SemiBold" /><HyperlinkButton Content="Disk properties" Click="OnDiskDetails" IsEnabled="{Binding CanInspect}" HorizontalAlignment="Right" Padding="6,0" /></Grid>
              <controls:PartitionMap x:Name="Map" IsEnabled="{Binding CanInspect}" />
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="{ThemeResource PartitionSystemBrush}" /><TextBlock Text="EFI / system" FontSize="12" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="{ThemeResource PartitionRecoveryBrush}" /><TextBlock Text="Recovery" FontSize="12" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="{ThemeResource PartitionReservedBrush}" /><TextBlock Text="Reserved" FontSize="12" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="{ThemeResource PartitionDataBrush}" /><TextBlock Text="Data" FontSize="12" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="{ThemeResource PartitionUnknownBrush}" /><TextBlock Text="Unknown type" FontSize="12" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="{ThemeResource PartitionUnmappedBrush}" /><TextBlock Text="Unmapped" FontSize="12" /></StackPanel>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Text="{Binding Layout.Explanation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel Spacing="8" Visibility="{Binding HasDiskSelection, Converter={StaticResource Visible}}">
              <TextBlock Text="Partitions and volumes" FontWeight="SemiBold" />
              <Grid Padding="14,6" ColumnSpacing="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="56" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                <TextBlock Text="Name / type" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Grid.Column="1" Text="File system" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Grid.Column="2" Text="Mount" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Grid.Column="3" Text="Capacity" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
              </Grid>
              <ListView x:Name="ChildList" ContextRequested="OnContextRequested" ItemsSource="{Binding Children}" SelectionChanged="OnExplorerSelectionChanged" IsEnabled="{Binding CanInspect}" AutomationProperties.Name="Partitions and volumes">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" /></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate>
                  <Grid Padding="2,8" ColumnSpacing="12" ContextRequested="OnContextRequested" ToolTipService.ToolTip="{Binding AccessibleName}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="56" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="{Binding Indent}" />
                      <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Type}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding Badges}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Filesystem}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Location}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Capacity}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate></ListView.ItemTemplate>
              </ListView>
              <TextBlock Text="{Binding PartitionEmptyMessage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
          </StackPanel>
          <Border x:Name="InspectorPanel" Grid.Row="1" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
            <StackPanel Spacing="16">
              <TextBlock Text="Selected item" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ActionExplanation}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
              <ItemsControl ItemsSource="{Binding Properties}"><ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Margin="0,0,0,12" Spacing="3"><TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" /></StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Expander Header="Current limitations" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" /></Expander>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
