<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Diskvio.Windows.Views.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:Diskvio.Windows.Converters"
      xmlns:controls="using:Diskvio.Windows.Controls"
      xmlns:views="using:Diskvio.Windows.Views" Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Page.Resources>
    <converters:BooleanToVisibilityConverter x:Key="Visible" />
    <CollectionViewSource x:Name="GroupedDevices" IsSourceGrouped="True" />
    <Style x:Key="ExplorerItem" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="PropertyValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" /><Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
  </Page.Resources>
  <Grid RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <CommandBar Margin="16,4,16,8" Background="Transparent" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
      <CommandBar.Content>
        <StackPanel VerticalAlignment="Center" Margin="8,0,24,0">
          <TextBlock Text="Storage" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DeviceCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>
      </CommandBar.Content>
      <AppBarButton Label="Refresh" Icon="Refresh" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Refresh devices (Ctrl+R or F5)">
        <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="R" Modifiers="Control" /><KeyboardAccelerator Key="F5" /></AppBarButton.KeyboardAccelerators>
      </AppBarButton>
      <AppBarSeparator />
      <AppBarButton Label="Mount" IsEnabled="{Binding CanMount}" Click="OnMount" ToolTipService.ToolTip="{Binding ActionExplanation}"><AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon></AppBarButton>
      <AppBarButton Label="Unmount" IsEnabled="{Binding CanUnmount}" Click="OnUnmount" ToolTipService.ToolTip="{Binding ActionExplanation}"><AppBarButton.Icon><FontIcon Glyph="&#xE8B6;" /></AppBarButton.Icon></AppBarButton>
      <AppBarSeparator />
      <AppBarToggleButton x:Name="InspectorToggle" Label="Information" Icon="ContactInfo" IsChecked="True" Click="OnToggleInspector" ToolTipService.ToolTip="Show or hide information (Ctrl+I)">
        <AppBarToggleButton.KeyboardAccelerators><KeyboardAccelerator Key="I" Modifiers="Control" /></AppBarToggleButton.KeyboardAccelerators>
      </AppBarToggleButton>
      <CommandBar.SecondaryCommands>
        <AppBarButton Label="Inspect partition layout" Icon="View" Command="{Binding InspectPartitionPlanningCommand}" />
        <AppBarButton Label="Rename volume label" Icon="Edit" IsEnabled="{Binding CanRename}" Click="OnRename" />
        <AppBarButton Label="Change drive letter" IsEnabled="{Binding CanSetDriveLetter}" Click="OnDriveLetter"><AppBarButton.Icon><FontIcon Glyph="&#xE8D4;" /></AppBarButton.Icon></AppBarButton>
      </CommandBar.SecondaryCommands>
    </CommandBar>
    <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Activity}" />
    <StackPanel Grid.Row="2" Margin="20,0,20,8" Spacing="6">
      <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error" Title="Storage request failed" Message="{Binding ErrorMessage}">
        <InfoBar.ActionButton><Button Content="Retry" Command="{Binding RefreshCommand}" /></InfoBar.ActionButton>
      </InfoBar>
      <InfoBar IsOpen="{Binding HasResult}" IsClosable="True" Closed="OnResultClosed" Severity="Success" Title="Operation completed" Message="{Binding ResultMessage}" />
      <InfoBar IsOpen="{Binding HasWarnings}" IsClosable="False" Severity="Warning" Title="Some device information is unavailable" Message="{Binding Warnings}" />
      <InfoBar IsOpen="{Binding HasDeviceNotice}" IsClosable="True" Closed="OnDeviceNoticeClosed" Severity="Informational" Title="Device unavailable" Message="{Binding DeviceNotice}" />
    </StackPanel>
    <Grid x:Name="WorkspaceGrid" Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="264" /><ColumnDefinition x:Name="SplitterColumn" Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition x:Name="NavigationRow" Height="*" /><RowDefinition x:Name="DetailRow" Height="0" /></Grid.RowDefinitions>
      <Grid x:Name="NavigationScroll" Padding="16,0,8,12" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <AutoSuggestBox PlaceholderText="Search devices and volumes" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find" AutomationProperties.Name="Search devices and volumes" />
        <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Filter devices">
          <ComboBoxItem Content="All devices" /><ComboBoxItem Content="Internal drives" /><ComboBoxItem Content="External drives" /><ComboBoxItem Content="Removable devices" />
        </ComboBox>
        <Grid Grid.Row="2">
          <ListView x:Name="DeviceList" ItemsSource="{Binding Source={StaticResource GroupedDevices}}" SelectedItem="{Binding BrowserSelection, Mode=OneWay}" SelectionChanged="OnDiskSelectionChanged" ContextRequested="OnContextRequested" IsEnabled="{Binding CanInspect}" ItemContainerStyle="{StaticResource ExplorerItem}" AutomationProperties.Name="Devices and search results">
            <ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="10,12,0,6" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
            <ListView.ItemTemplate><DataTemplate>
              <Grid Padding="2,9" ColumnSpacing="10" ContextRequested="OnContextRequested" ToolTipService.ToolTip="{Binding AccessibleName}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Icon}" FontSize="22" VerticalAlignment="Top" Margin="0,3,0,0" />
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding BrowserSummary}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
          <StackPanel Margin="12,24" Spacing="8" Visibility="{Binding HasNoMatches, Converter={StaticResource Visible}}">
            <TextBlock Text="No matching devices" FontWeight="SemiBold" /><TextBlock Text="Try another name, identifier or filter." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
        <Expander Grid.Row="3" Header="Unattached volumes" HorizontalAlignment="Stretch" Visibility="{Binding HasUnattachedVolumes, Converter={StaticResource Visible}}">
          <ListView x:Name="UnattachedList" ItemsSource="{Binding VisibleUnattachedVolumes}" SelectionChanged="OnUnattachedSelected" ContextRequested="OnContextRequested" IsEnabled="{Binding CanInspect}" AutomationProperties.Name="Volumes without a resolved disk">
            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ContextRequested="OnContextRequested" ToolTipService.ToolTip="{Binding AccessibleName}" /></DataTemplate></ListView.ItemTemplate>
          </ListView>
        </Expander>
      </Grid>
      <Thumb x:Name="SidebarSplitter" Grid.Column="1" DragDelta="OnSidebarDrag" KeyDown="OnSidebarSplitterKeyDown" IsTabStop="True" UseSystemFocusVisuals="True" AutomationProperties.Name="Resize device sidebar" AutomationProperties.HelpText="Use Left and Right arrow keys to resize">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" /></Grid></ControlTemplate></Thumb.Template>
      </Thumb>
      <ScrollViewer x:Name="DetailScroll" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" Padding="20,8,24,24">
        <Grid x:Name="ContentGrid" ColumnSpacing="24" RowSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="280" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Spacing="24">
            <StackPanel Spacing="12" Margin="0,32" Visibility="{Binding IsInitialLoading, Converter={StaticResource Visible}}">
              <ProgressRing IsActive="{Binding IsInitialLoading}" Width="28" Height="28" HorizontalAlignment="Left" AutomationProperties.Name="Discovering storage devices" />
              <TextBlock Text="Discovering storage devices" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Reading connected disks, partitions and volumes…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{Binding HasUnattachedSelection, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding SelectionName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="This volume could not be associated with a physical disk. Its reported properties are available in Information." TextWrapping="Wrap" />
              <TextBlock Text="{Binding ActionExplanation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="16" Visibility="{Binding HasDiskSelection, Converter={StaticResource Visible}}">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEDA2;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="{Binding DiskName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  <TextBlock Text="{Binding DiskSubtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                  <TextBlock Text="{Binding DiskModel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="18" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="Total capacity" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DiskCapacity}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Connection" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DiskConnection}" Style="{StaticResource PropertyValue}" /></StackPanel>
                <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Partition scheme" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DiskScheme}" Style="{StaticResource PropertyValue}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Status" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DiskStatus}" Style="{StaticResource PropertyValue}" /></StackPanel>
              </Grid>
            </StackPanel>
            <StackPanel Spacing="10" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" Margin="0,24">
              <FontIcon Glyph="&#xEDA2;" FontSize="36" HorizontalAlignment="Left" />
              <TextBlock Text="Connect a storage device" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="No physical disks were reported. Connect a drive and refresh to inspect it. Unattached volumes remain available in the sidebar." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Button Content="Refresh devices" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="12" Visibility="{Binding HasDiskSelection, Converter={StaticResource Visible}}">
              <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,8" />
              <Grid><TextBlock Text="Partition layout" FontSize="16" FontWeight="SemiBold" /><HyperlinkButton Content="Disk properties" Click="OnDiskDetails" IsEnabled="{Binding CanInspect}" HorizontalAlignment="Right" Padding="6,0" /></Grid>
              <controls:PartitionMap x:Name="Map" IsEnabled="{Binding CanInspect}" />
              <TextBlock Text="{Binding Layout.Explanation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel Spacing="10" Visibility="{Binding HasDiskSelection, Converter={StaticResource Visible}}">
              <Grid><TextBlock Text="Partitions and volumes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /><ComboBox SelectedIndex="0" SelectionChanged="OnSortChanged" HorizontalAlignment="Right" AutomationProperties.Name="Sort partitions"><ComboBoxItem Content="Physical order" /><ComboBoxItem Content="Name" /><ComboBoxItem Content="Largest first" /></ComboBox></Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel MinWidth="720" Spacing="4">
                  <Grid Padding="14,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="56" /><ColumnDefinition Width="90" /><ColumnDefinition Width="84" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Name / identifier" /><TextBlock Grid.Column="1" Text="Format" /><TextBlock Grid.Column="2" Text="Mount" /><TextBlock Grid.Column="3" Text="Capacity" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="Used" HorizontalAlignment="Right" /><TextBlock Grid.Column="5" Text="Available" HorizontalAlignment="Right" />
                  </Grid>
                  <ListView x:Name="ChildList" ItemsSource="{Binding Children}" SelectionChanged="OnExplorerSelectionChanged" ContextRequested="OnContextRequested" IsEnabled="{Binding CanInspect}" ItemContainerStyle="{StaticResource ExplorerItem}" AutomationProperties.Name="Partitions and volumes">
                    <ListView.ItemTemplate><DataTemplate>
                      <Grid Padding="2,9" ColumnSpacing="12" ContextRequested="OnContextRequested" ToolTipService.ToolTip="{Binding AccessibleName}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /><ColumnDefinition Width="56" /><ColumnDefinition Width="90" /><ColumnDefinition Width="84" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="{Binding Indent}" />
                          <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Device.Identifier}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding Type}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" /><TextBlock Text="{Binding Badges}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" /></StackPanel>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Filesystem}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Location}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Capacity}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding ExactCapacity}" /><TextBlock Grid.Column="4" Text="{Binding Used}" HorizontalAlignment="Right" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{Binding Available}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Text="{Binding PartitionEmptyMessage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Expander x:Name="PlanningExpander" Header="Partition planning · Preview only" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{Binding HasDiskSelection, Converter={StaticResource Visible}}">
              <views:PartitionPlanningView x:Name="PlanningWorkspace" />
            </Expander>
          </StackPanel>
          <Border x:Name="InspectorPanel" Grid.Column="1" Padding="20,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" VerticalAlignment="Top">
            <StackPanel Spacing="16">
              <Grid><TextBlock Text="Information" FontSize="16" FontWeight="SemiBold" /><Button HorizontalAlignment="Right" Padding="5" Click="OnCopyIdentifier" IsEnabled="{Binding HasSelection}" ToolTipService.ToolTip="Copy selected identifier" AutomationProperties.Name="Copy selected identifier"><FontIcon Glyph="&#xE8C8;" FontSize="14" /></Button></Grid>
              <StackPanel Spacing="5"><TextBlock Text="{Binding SelectionName}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding InspectorTitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding SelectionBadges}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel>
              <TextBlock Text="{Binding ActionExplanation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
              <ItemsControl ItemsSource="{Binding PropertySections}"><ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Spacing="12" Margin="0,0,0,20">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,0,0,12" Spacing="4"><TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding Value}" Style="{StaticResource PropertyValue}"><TextBlock.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copy value" Click="OnCopyProperty" /></MenuFlyout></TextBlock.ContextFlyout></TextBlock></StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Expander Header="Current limitations" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" /></Expander>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,8">
      <Grid><TextBlock Text="{Binding BrowserSummary}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding LastUpdated}" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
    </Border>
  </Grid>
</Page>
