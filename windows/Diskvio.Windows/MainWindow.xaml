        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Diskvio.Windows.Views" Title="Diskvio">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="Diskvio" Subtitle="Storage explorer">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico" /></TitleBar.IconSource>
        </TitleBar>
        <views:DevicesPage Grid.Row="1" />
    </Grid>
</Window>
