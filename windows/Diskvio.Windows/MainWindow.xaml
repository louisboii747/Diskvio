<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Diskvio.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Diskvio.Windows.Views"
    xmlns:converters="using:Diskvio.Windows.Converters"
    Title="Diskvio">
    <Grid>
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="Diskvio">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Shell" Grid.Row="1"
                        PaneDisplayMode="Auto" OpenPaneLength="208"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        AlwaysShowHeader="False" IsPaneOpen="True"
                        SelectionFollowsFocus="Enabled"
                        AutomationProperties.Name="Workspaces">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DevicesNavigationItem" Content="Devices" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="16,12" Spacing="4"
                            Visibility="{Binding IsPaneOpen, ElementName=Shell, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="Diskvio for Windows" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Storage explorer" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <views:DevicesPage />
        </NavigationView>
    </Grid>
</Window>
