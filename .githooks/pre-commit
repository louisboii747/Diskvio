#!/bin/sh
set -eu

git diff --cached --check
DISKVIO_CHECK_TOOLS="$(git rev-parse --show-toplevel)/target/check-tools"
export DISKVIO_CHECK_TOOLS
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/diskvio-commit.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM
git checkout-index --all --prefix="$snapshot/"

if command -v python3 >/dev/null 2>&1; then
    python_command=python3
else
    python_command=python
fi

"$python_command" "$snapshot/scripts/check.py" all
